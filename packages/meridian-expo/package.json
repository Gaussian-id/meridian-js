{
  "name": "@gaussian-id/meridian-expo",
  "version": "0.1.0",
  "description": "Gauss Meridian for Expo and React Native: a keyless client that calls your own server route.",
  "keywords": [
    "meridian",
    "gauss",
    "gaussian",
    "ai",
    "llm",
    "sdk",
    "expo",
    "react-native"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaussian-id/meridian-js.git",
    "directory": "packages/meridian-expo"
  },
  "homepage": "https://github.com/Gaussian-id/meridian-js#readme",
  "bugs": {
    "url": "https://github.com/Gaussian-id/meridian-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@gaussian-id/meridian": "workspace:*"
  },
  "peerDependencies": {
    "expo": ">=52"
  },
  "devDependencies": {
    "expo": "^54"
  }
}
