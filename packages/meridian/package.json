{
  "name": "@gaussian-id/meridian",
  "version": "0.1.0",
  "description": "The official TypeScript SDK for Gauss Meridian: one API for many AI models, routed by Meridian.",
  "keywords": [
    "meridian",
    "gauss",
    "gaussian",
    "ai",
    "llm",
    "sdk",
    "routing",
    "typescript"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaussian-id/meridian-js.git",
    "directory": "packages/meridian"
  },
  "homepage": "https://github.com/Gaussian-id/meridian-js#readme",
  "bugs": {
    "url": "https://github.com/Gaussian-id/meridian-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./admin": {
      "import": {
        "types": "./dist/admin.d.ts",
        "default": "./dist/admin.js"
      },
      "require": {
        "types": "./dist/admin.d.cts",
        "default": "./dist/admin.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup"
  }
}
