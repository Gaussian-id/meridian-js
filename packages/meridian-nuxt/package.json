{
  "name": "@gaussian-id/meridian-nuxt",
  "version": "0.1.0",
  "description": "Gauss Meridian for Nuxt: a Nuxt module with a server client and composables.",
  "keywords": [
    "meridian",
    "gauss",
    "gaussian",
    "ai",
    "llm",
    "sdk",
    "nuxt",
    "nuxt-module"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaussian-id/meridian-js.git",
    "directory": "packages/meridian-nuxt"
  },
  "homepage": "https://github.com/Gaussian-id/meridian-js#readme",
  "bugs": {
    "url": "https://github.com/Gaussian-id/meridian-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./composables": {
      "types": "./dist/composables.d.ts",
      "import": "./dist/composables.js"
    }
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@gaussian-id/meridian": "workspace:*"
  },
  "peerDependencies": {
    "nuxt": ">=3.13",
    "h3": ">=1.12 <2"
  },
  "devDependencies": {
    "nuxt": "^4",
    "vue": "^3",
    "h3": "^1"
  }
}
