  "components": {
    "schemas": {
      "CredentialMetadata": {
        "type": "object",
        "required": [
          "provider",
          "hint",
          "created_at",
          "last_used_at",
          "policy"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "hint": {
            "type": "string",
            "maxLength": 4,
            "minLength": 4,
            "pattern": "^[!-~]{4}$"
          },
          "last_used_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "policy": {
            "$ref": "#/components/schemas/CredentialPolicy"
          },
          "provider": {
            "type": "string"
          }
        }
      },
      "CredentialPolicy": {
        "type": "string",
        "enum": [
          "prefer",
          "require"
        ]
      },
      "SetCredential": {
        "type": "object",
        "required": [
          "credential"
        ],
        "properties": {
          "credential": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 8,
            "pattern": "^[!-~]{8,4096}$"
          },
          "policy": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CredentialPolicy"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "SupplierCapabilities": {
        "type": "object",
        "required": [
          "streaming",
          "tools",
          "vision",
          "json_output"
        ],
        "properties": {
          "json_output": {
            "type": "boolean"
          },
          "streaming": {
            "type": "boolean"
          },
          "tools": {
            "type": "boolean"
          },
          "vision": {
            "type": "boolean"
          }
        }
      },
      "SupplierCatalogueResponse": {
        "type": "object",
        "required": [
          "version",
          "models"
        ],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SupplierModelResponse"
            }
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SupplierDelivery": {
        "type": "string",
        "enum": [
          "direct",
          "openrouter"
        ]
      },
      "SupplierLimits": {
        "type": "object",
        "required": [
          "context_tokens",
          "max_output_tokens"
        ],
        "properties": {
          "context_tokens": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_output_tokens": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "SupplierModelResponse": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "delivery",
          "capabilities",
          "limits",
          "supplier_price"
        ],
        "properties": {
          "capabilities": {
            "$ref": "#/components/schemas/SupplierCapabilities"
          },
          "delivery": {
            "$ref": "#/components/schemas/SupplierDelivery"
          },
          "id": {
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/SupplierLimits"
          },
          "provider": {
            "type": "string"
          },
          "routing_class": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/SupplierRoutingClass"
              },
              {
                "type": "null"
              }
            ]
          },
          "supplier_price": {
            "$ref": "#/components/schemas/SupplierPriceResponse"
          }
        }
      },
      "SupplierPriceResponse": {
        "type": "object",
        "required": [
          "input_per_million",
          "output_per_million"
        ],
        "properties": {
          "cached_input_per_million": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "input_per_million": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "output_per_million": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "SupplierRoutingClass": {
        "type": "string",
        "enum": [
          "light",
          "standard",
          "advanced"
        ]
      }
    },
    "securitySchemes": {
      "AdminBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "AdminBearer": []
    }
  ]
}
